{
  "name": "@matilha/design-system",
  "version": "1.0.0",
  "description": "Design system Matilha — tokens, Tailwind preset e componentes do UI Kit + Branding",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./tailwind": "./tailwind.preset.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/typography.css": "./src/styles/typography.css",
    "./styles/fonts.css": "./src/styles/fonts.css",
    "./styles/tailwind.css": "./src/styles/tailwind.css",
    "./styles/global.css": "./src/styles/global.css",
    "./styles/brand.css": "./src/styles/brand.css",
    "./brand": "./src/brand/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src",
    "fonts",
    "logo",
    "tailwind.preset.ts",
    "tailwind.config.ts",
    "postcss.config.js",
    "MATILHA-UI.md",
    "PROMPT.md",
    "INSTALL.md",
    "AGENTS.md",
    "README.md",
    ".cursor"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@heroicons/react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "design-system",
    "matilha",
    "react",
    "ui-kit",
    "tailwind"
  ],
  "license": "MIT"
}
